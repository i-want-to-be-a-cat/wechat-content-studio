# Optional model configuration for the local backend.
STUDIO_DATA_DIR=

# Text: Ollama + Qwen3 by default. The endpoint must expose
# /v1/chat/completions.
TEXT_API_BASE_URL=http://127.0.0.1:11434/v1
TEXT_API_KEY=ollama
TEXT_MODEL=qwen3:8b

# Images: choose "stability" for the hosted REST API or "comfyui"
# for a local ComfyUI server. ComfyUI needs an exported API-format
# workflow file configured below.
IMAGE_PROVIDER=comfyui
IMAGE_API_BASE_URL=http://127.0.0.1:8188
IMAGE_WORKFLOW_PATH=
STABILITY_API_KEY=
STABILITY_ENGINE=stable-diffusion-xl-1024-v1-0
